rules_version = '2';

// Role checks in this file mirror ROLE_CAPABILITIES in schemas/src/admin.ts —
// rules cannot import TS, so when a role or capability changes there, update
// the corresponding hasRole/hasAnyRole calls here and keep validRoles() in sync.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function validRoles() {
      return ['full_admin', 'program_staff', 'health_staff'];
    }

    function callerAdminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data;
    }

    function getRole() {
      return callerAdminData().role;
    }

    function isAnyAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) &&
        callerAdminData().disabled != true;
    }

    function isFullAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) &&
        callerAdminData().disabled != true &&
        callerAdminData().role == 'full_admin';
    }

    function hasRole(role) {
      return isAnyAdmin() && getRole() == role;
    }

    function hasAnyRole(roles) {
      return isAnyAdmin() && getRole() in roles;
    }

    // Admin roster — split into separate allow statements to avoid circular evaluation
    match /admins/{email} {
      // Any signed-in user can read their own admin doc
      allow read: if isSignedIn() && request.auth.token.email == email;
      // Full admins can read any admin doc
      allow read: if isFullAdmin();
      // Only full admins can write, and only recognized role values —
      // functions and the client fail closed on anything else, so an
      // unvalidated write here would silently create a no-access admin.
      allow delete: if isFullAdmin();
      allow create, update: if isFullAdmin() &&
        request.resource.data.role in validRoles();
    }

    // Families — any admin can read; family members or full_admin can write
    match /families/{familyId} {
      allow read: if isAnyAdmin() ||
        (isSignedIn() && request.auth.token.email in resource.data.emails);
      allow write: if hasRole('full_admin') ||
        (isSignedIn() && request.auth.token.email in resource.data.emails);

      match /parents/{parentId} {
        allow read: if isAnyAdmin() ||
          (isSignedIn() && request.auth.token.email in
            get(/databases/$(database)/documents/families/$(familyId)).data.emails);
        allow write: if hasRole('full_admin');
      }

      match /campers/{camperId} {
        allow read: if isAnyAdmin() ||
          (isSignedIn() && request.auth.token.email in
            get(/databases/$(database)/documents/families/$(familyId)).data.emails);
        allow write: if hasRole('full_admin') ||
          (isSignedIn() && request.auth.token.email in
            get(/databases/$(database)/documents/families/$(familyId)).data.emails);

        // Private sub-documents — one match for every sensitive section.
        // Section gates mirror PRIVATE_SECTIONS in schemas/src/families.ts:
        // adding a new section means one condition here, nothing else.
        match /private/{section} {
          allow read: if
            (section == 'health' && hasAnyRole(['health_staff', 'full_admin'])) ||
            (section == 'demographics' && hasRole('full_admin'));
          allow write: if hasRole('full_admin');
        }
      }
    }

    // Camp year document — any signed-in user can read camp info (pricing, spots)
    match /camps/{campYear} {
      allow read: if isSignedIn();
      allow write: if hasRole('full_admin');

      // Registrations — any admin can read; only roles with the
      // writeRegistrations capability can write; family members can read their own
      match /registrations/{registrationId} {
        allow read: if isAnyAdmin() ||
          (isSignedIn() && request.auth.token.email in resource.data.familyEmails);
        allow write: if hasAnyRole(['program_staff', 'full_admin']);
      }
    }

    // Payments — full_admin only
    match /payments/{paymentId} {
      allow read, write: if hasRole('full_admin');
    }

    // Credits — full_admin only
    match /credits/{familyId} {
      allow read, write: if hasRole('full_admin');
    }

    // Catch-all: full_admin fallback for any other paths
    match /{document=**} {
      allow read, write: if hasRole('full_admin');
    }
  }
}
