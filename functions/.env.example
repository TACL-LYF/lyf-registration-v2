# Copy to .env and fill in. Loaded by dotenv at runtime and by the Firebase CLI
# at deploy time (trigger database bindings are resolved from these values).

# --- Firestore ---
# v2 runs in the same Firebase project as v1; v1's data is in "(default)" and
# "internal-test", so v2 uses its own named databases.
FIRESTORE_DATABASE_ID=lyf-v2
FIRESTORE_TEST_DATABASE_ID=lyf-v2-test

# Comma-separated origins Stripe may redirect back to after checkout.
# Include the staging host while both sites are live.
ALLOWED_REDIRECT_ORIGINS=https://lyf-registration.tacl.org,https://v2.lyf-registration.tacl.org

# --- Stripe (v2 has its own webhook endpoints, so its own signing secrets) ---
STRIPE_API_KEY=
STRIPE_TEST_API_KEY=
STRIPE_ENDPOINT_SECRET=
STRIPE_TEST_ENDPOINT_SECRET=

# --- Registration email (Gmail OAuth2) ---
EMAIL=
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
EMAIL_REFRESH_TOKEN=

# --- Firebase web config (used by email templates / links) ---
GATSBY_FIREBASE_API_KEY=
GATSBY_FIREBASE_AUTH_DOMAIN=
GATSBY_FIREBASE_PROJECT_ID=
GATSBY_FIREBASE_STORAGE_BUCKET=
GATSBY_FIREBASE_MESSAGING_SENDER_ID=
GATSBY_FIREBASE_APP_ID=
GATSBY_FIREBASE_MEASUREMENT_ID=

# --- Mailchimp ---
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER=

# --- Slack (point at a staging channel during soak) ---
SLACK_REGISTRATION_WEBHOOK=
SLACK_REGISTRATION_FOR_CAMP_WEBHOOK=
SLACK_ERROR_WEBHOOK=
