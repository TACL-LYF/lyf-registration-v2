# Rename this file to .env and supply the values listed below.
# Also make sure they're set as GitHub Actions secrets for deployment.

GATSBY_FIREBASE_API_KEY=insertValue
GATSBY_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
GATSBY_FIREBASE_PROJECT_ID=insertValue
GATSBY_FIREBASE_STORAGE_BUCKET=insertValue
GATSBY_FIREBASE_MESSAGING_SENDER_ID=insertValue
GATSBY_FIREBASE_APP_ID=insertValue
GATSBY_FIREBASE_MEASUREMENT_ID=insertValue

# v2 uses its own Firestore databases inside the shared project
# ("(default)" and "internal-test" belong to v1).
GATSBY_FIRESTORE_DATABASE_ID=lyf-v2
GATSBY_FIRESTORE_TEST_DATABASE_ID=lyf-v2-test

# Local development against the emulators
# GATSBY_USE_EMULATORS=true
